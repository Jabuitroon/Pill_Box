// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// --- Enums ---

enum UserRole {
  PATIENT
  PHYSIOTHERAPIST
  ADMIN
}

enum UserStatusEnum {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum TimeOfDay {
  MORNING
  AFTERNOON
  NIGHT
}

// --- Modelos ---

model User {
  user_id      String   @id @default(uuid())
  name         String   @map("usu_name")
  lastName     String   @map("usu_last_name")
  phone        String?  @map("usu_phone")
  email        String   @unique @map("usu_email")
  passwordHash String   @map("usu_password")
  role         UserRole @default(PATIENT) @map("usu_role")
  avatar       String?  @map("usu_avatar")

  status UserStatusEnum @default(ACTIVE)

  // Seguridad y Auditoría
  emailConfirm    Boolean  @default(false)
  twoFactorEnable Boolean  @default(false)
  twoFactorSecret String?
  createdAt       DateTime @default(now()) @map("created_at")
  updateAt        DateTime @updatedAt

  // --- Relaciones Médico-Paciente ---
  // El ID del fisio que atiende a este usuario
  physiotherapistId String? @map("physiotherapist_id")
  physiotherapist   User?   @relation("PhysioToPatient", fields: [physiotherapistId], references: [user_id])

  // Lista de pacientes (solo si el usuario es FISIO)
  patients User[] @relation("PhysioToPatient")

  // --- Relaciones de Medicación ---
  prescriptions Prescription[]

  @@index([email])
  @@index([createdAt])
  @@map("tbl_user")
}

model Pill {
  pill_id     String  @id @default(uuid())
  name        String  @unique // Ej: "Hidroclorotiazida"
  description String? @db.Text

  // Relación inversa con las recetas
  prescriptions Prescription[]

  @@map("tbl_pill")
}

model Prescription {
  prescription_id String     @id @default(uuid())
  patientId       String     @map("patient_id")
  patient         User       @relation(fields: [patientId], references: [user_id])
  pillId          String     @map("pill_id")
  pill            Pill       @relation(fields: [pillId], references: [pill_id])
  intakeTime      String     @map("intake_time")
  schedule        TimeOfDay  @map("pres_schedule")
  timesPerDay     Int        @default(1) @map("times_per_day")
  // Para saber si el recordatorio está activo
  isActive        Boolean    @default(true) @map("is_active")
  createdAt       DateTime   @default(now()) @map("created_at")
  reminders       Reminder[]

  @@map("tbl_prescription")
}

model Reminder {
  reminder_id String @id @default(uuid()) @map("rec_id")

  // 🔗 Relación con la receta (NO directamente con usuario)
  prescriptionId String       @map("prescription_id")
  prescription   Prescription @relation(fields: [prescriptionId], references: [prescription_id])

  // ⏰ Hora específica del recordatorio (por si hay múltiples al día)
  scheduledTime String @map("scheduled_time") // "08:00"

  // 📊 Estado del envío
  sent   Boolean   @default(false) @map("sent")
  sentAt DateTime? @map("sent_at")

  // 📅 Auditoría
  createdAt DateTime @default(now()) @map("created_at")

  @@index([prescriptionId])
  @@index([scheduledTime])
  @@map("tbl_recordatorio")
}
