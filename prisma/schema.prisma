// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// --- Enums ---

enum UserRole {
  PATIENT
  PHYSIOTHERAPIST
  ADMIN
}

enum UserStatusEnum {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum TimeOfDay {
  MORNING
  AFTERNOON
  NIGHT
}

// --- Modelos ---

model User {
  user_id      String   @id @default(uuid())
  name         String   @map("usu_name")
  lastName     String   @map("usu_last_name")
  phone        String?  @map("usu_phone")
  email        String   @unique @map("usu_email")
  passwordHash String   @map("usu_password")
  role         UserRole @default(PATIENT) @map("usu_role")
  avatar       String?  @map("usu_avatar")

  status UserStatusEnum @default(ACTIVE)

  // Seguridad y Auditoría
  emailConfirm    Boolean  @default(false)
  twoFactorEnable Boolean  @default(false)
  twoFactorSecret String?
  createdAt       DateTime @default(now()) @map("created_at")
  updateAt        DateTime @updatedAt

  // --- Relaciones Médico-Paciente ---
  // El ID del fisio que atiende a este usuario
  physiotherapistId String? @map("physiotherapist_id")
  physiotherapist   User?   @relation("PhysioToPatient", fields: [physiotherapistId], references: [user_id])

  // Lista de pacientes (solo si el usuario es FISIO)
  patients User[] @relation("PhysioToPatient")

  // --- Relaciones de Medicación ---
  prescriptions Prescription[]

  @@index([email])
  @@index([createdAt])
  @@map("tbl_user")
}

model Pill {
  pill_id     String  @id @default(uuid())
  name        String  @unique // Ej: "Hidroclorotiazida"
  description String? @db.Text

  // Relación inversa con las recetas
  prescriptions Prescription[]

  @@map("tbl_pill")
}

model Prescription {
  prescription_id String @id @default(uuid())

  // Relación con el paciente (User)
  patientId String @map("patient_id")
  patient   User   @relation(fields: [patientId], references: [user_id])

  // CORRECCIÓN: El campo "references" ahora apunta a pill_id en el modelo Pill
  pillId String @map("pill_id")
  pill   Pill   @relation(fields: [pillId], references: [pill_id])

  // Atributos de la toma solicitados
  schedule    TimeOfDay @map("pres_schedule") // Mañana, tarde o noche
  timesPerDay Int       @default(1) @map("times_per_day")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("tbl_prescription")
}
